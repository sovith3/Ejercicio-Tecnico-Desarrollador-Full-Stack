# =============================================================================================
# InvoiceHub · variables de entorno del stack completo (.NET 8 + Redis + React/Vite)
# ---------------------------------------------------------------------------------------------
# Un unico archivo alimenta a los tres servicios:
#   1. docker compose lo lee automaticamente desde la raiz del proyecto para interpolar ${...}
#      en docker-compose.yml y para inyectar variables en los contenedores.
#   2. La API las recibe con la jerarquia de doble guion bajo de .NET:
#      ConnectionStrings__RedisConnection, Cache__Password, SourceData__FilePath, ...
#   3. Vite lee de aqui las variables VITE_* (su envDir apunta a esta carpeta), que son las unicas
#      que llegan al navegador; ninguna credencial de infraestructura viaja al cliente.
#
# PLANTILLA de configuracion del stack. Copiela como .env y arranque:
#
#     cp .env.example .env
#     docker compose up --build -d
#
# El archivo .env real NO se versiona (esta en .gitignore): los valores de demostracion viajan aqui
# para que el stack se levante con un comando, y los secretos de un entorno real viven en el gestor
# de secretos del despliegue.
# =============================================================================================

# Nombre del proyecto compose: prefija contenedores, red y volumenes.
COMPOSE_PROJECT_NAME=invoicehub

# ---------------------------------------------------------------------------------------------
# Redes y puertos
# ---------------------------------------------------------------------------------------------
# Puerto publicado para la API (Swagger, /health, acceso directo para pruebas).
API_HOST_PORT=5145

# Puerto interno de la API: viaja al contenedor como ASPNETCORE_URLS.
API_INTERNAL_PORT=8080

# Interfaz donde se publica la API (0.0.0.0 para que sea accesible desde el host).
API_BIND_ADDRESS=0.0.0.0

# Puerto publicado para el panel React servido por nginx.
WEB_HOST_PORT=5173

# Puerto interno de nginx.
WEB_INTERNAL_PORT=80

# Interfaz donde se publica el panel.
WEB_BIND_ADDRESS=0.0.0.0

# Puerto de Redis publicado en el host, solo para inspeccion local con redis-cli.
REDIS_HOST_PORT=6379

# Interfaz de publicacion de Redis: loopback, de modo que la cache no queda expuesta a la red.
REDIS_BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------------------------
# Redis (cache de lectura; si no responde, la API degrada a cache en memoria)
# ---------------------------------------------------------------------------------------------
# Nombre del servicio dentro de la red de compose (DNS interno, no es una IP ni un hostname externo).
REDIS_HOST=redis-cache

# Puerto interno de Redis.
REDIS_PORT=6379

# Contrasena del servidor: viaja como --requirepass en el comando de Redis y como
# ConnectionStrings__RedisConnection / Cache__Password en la API.
REDIS_PASSWORD=InvoiceHub.Redis.2026

# Usuario ACL (Redis 6+). Vacio cuando el servidor solo usa requirepass.
REDIS_USER=

# Base de datos logica de Redis.
REDIS_DATABASE=0

# Activa TLS hacia Redis (false en la red interna de compose).
REDIS_SSL=false

# Prefijo de las claves cuando se comparte una instancia de Redis con otras aplicaciones.
REDIS_INSTANCE_NAME=invoicehub:

# Vigencia de las entradas de lectura: busquedas y detalle 30 s, reportes y panel 60 s.
CACHE_INVOICE_TTL_SECONDS=30
CACHE_REPORT_TTL_SECONDS=60

# ---------------------------------------------------------------------------------------------
# Backend .NET 8
# ---------------------------------------------------------------------------------------------
# Entorno del host .NET (Production en contenedor).
ASPNETCORE_ENVIRONMENT=Production

# Zona horaria del contenedor y reloj de negocio con el que se evaluan mora y vencimientos.
TZ=America/Santiago
CLOCK_TIMEZONE=America/Santiago

# Archivo SQLite (ruta relativa al directorio de contenido de la API, /app en el contenedor).
DATABASE_FILE_PATH=data/invoicehub.db

# Ruta interna de los scripts SQL versionados (se montan desde el host como volumen de solo lectura).
DATABASE_SCRIPTS_CONTAINER_PATH=/app/database/scripts

# Ruta en el host de la carpeta de scripts SQL.
SCRIPTS_HOST_PATH=./backend/database/scripts

# Recrea la base cuando cambia la huella del esquema y siembra el usuario administrador si falta.
DATABASE_RECREATE_ON_SCHEMA_CHANGE=true
DATABASE_SEED_ADMIN_USER=true

# Origen del enunciado: ruta en el host (se monta como volumen) y ruta dentro del contenedor.
SOURCE_JSON_HOST_PATH=./bd_exam_invoices.json
SOURCE_JSON_CONTAINER_PATH=/app/source/bd_exam_invoices.json

# Importa el origen en el arranque solo si la base esta vacia (operacion idempotente).
SOURCE_IMPORT_ON_STARTUP=true

# Limite defensivo del tamano del archivo JSON aceptado (64 MB).
SOURCE_MAX_FILE_SIZE_BYTES=67108864

# Firma y vigencia del token JWT.
SECURITY_ISSUER=InvoiceHub
SECURITY_AUDIENCE=InvoiceHub.Client
SECURITY_JWT_KEY=invoicehub-development-signing-key-change-me-2f4a91
SECURITY_TOKEN_LIFETIME_MINUTES=480

# false: solo las escrituras exigen token; true: toda la API queda protegida.
SECURITY_REQUIRE_AUTHENTICATION=false

# Usuario administrador sembrado en la primera ejecucion.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=InvoiceHub.2026
ADMIN_DISPLAY_NAME=Administrador InvoiceHub
ADMIN_ROLE=Administrator

# Host de la API.
SWAGGER_ENABLED=true
HTTPS_REDIRECTION=false
API_SERVE_STATIC_FILES=true

# Origenes permitidos por CORS (__0, __1 y __2 en la jerarquia de .NET).
CORS_ORIGIN_WEB=http://localhost:5173
CORS_ORIGIN_WEB_PREVIEW=http://localhost:4173
CORS_ORIGIN_API=http://localhost:5145

# ---------------------------------------------------------------------------------------------
# Frontend React (Vite · prefijo VITE_, equivalente a REACT_APP_ en Create React App)
# ---------------------------------------------------------------------------------------------
# Ruta base que consume el panel. "/api" aprovecha el proxy inverso de nginx (mismo origen, sin CORS);
# para apuntar a otra API se usa una URL absoluta, por ejemplo http://mi-servidor:5145/api.
VITE_API_BASE_URL=/api

# Tiempo maximo de espera de cada peticion del panel, en milisegundos.
VITE_API_TIMEOUT_MS=15000

# Titulo visible del panel.
VITE_APP_TITLE="Facturia · Control de facturacion"

# Credenciales precargadas del formulario de acceso (solo demostracion).
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=InvoiceHub.2026

# Servidor de desarrollo de Vite y destino del proxy hacia la API.
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:5145

# Destino del proxy inverso de nginx dentro de la red de compose (se resuelve al arrancar nginx).
WEB_API_UPSTREAM=http://net8-backend:8080
