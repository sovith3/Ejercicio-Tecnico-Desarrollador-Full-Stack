{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "UseHttpsRedirection": false,
    "ServeStaticFiles": true,
    "SwaggerEnabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:3000"
    ]
  },
  "Database": {
    "ConnectionString": null,
    "FilePath": "data/invoicehub.db",
    "ScriptsPath": null,
    "RecreateOnSchemaChange": true,
    "SeedAdminUser": true
  },
  "SourceData": {
    "FilePath": "data/bd_exam_invoices.json",
    "MaxFileSizeBytes": 67108864,
    "ImportOnStartup": false
  },
  "Cache": {
    "Provider": "Redis",
    // Cadena completa opcional. Si se informa tiene prioridad sobre Host/Port; el entorno puede
    // sobrescribirla con ConnectionStrings__RedisConnection (jerarquia de doble guion bajo de .NET).
    "ConnectionString": null,
    "Host": "localhost",
    "Port": 6379,
    // Credenciales de Redis: en contenedor llegan desde el .env (REDIS_PASSWORD) y nunca viajan al cliente.
    "User": null,
    "Password": null,
    "Database": 0,
    "UseSsl": false,
    "InstanceName": "invoicehub:",
    "UseRedis": true,
    "InvoiceTimeToLiveSeconds": 30,
    "ReportTimeToLiveSeconds": 60
  },
  "Clock": {
    "TimeZoneId": "America/Santiago"
  },
  "Security": {
    "Issuer": "InvoiceHub",
    "Audience": "InvoiceHub.Client",
    "Key": "invoicehub-development-signing-key-change-me-2f4a91",
    "TokenLifetimeMinutes": 480,
    "RequireAuthentication": false,
    "AdminUsername": "admin",
    "AdminPassword": "InvoiceHub.2026",
    "AdminDisplayName": "Administrador InvoiceHub",
    "AdminRole": "Administrator"
  }
