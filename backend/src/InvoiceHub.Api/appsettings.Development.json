{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Cache": {
    // En desarrollo la cache en memoria evita depender de un servidor Redis local; con el
    // docker-compose (que levanta Redis) basta con poner UseRedis en true.
    "Provider": "Memory",
    "UseRedis": false
  },
  "SourceData": {
    // Carga inicial automatica cuando la base de datos esta vacia.
    "ImportOnStartup": true
  }
}
